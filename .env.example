# Salin file ini menjadi .env lalu isi nilainya:  cp .env.example .env
# File .env TIDAK BOLEH di-commit (sudah ada di .gitignore).
# Di Jenkins, isi file .env disimpan sebagai credential "Secret file" dengan ID: kosanhub-env

APP_NAME=KosanHub
APP_ENV=production
# Buat dengan: php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_LEVEL=info

# Username Docker Hub pemilik image (dipakai compose.yaml: <user>/kosanhub:latest)
DOCKERHUB_USER=ganti-username-dockerhub
# Port aplikasi di host
APP_PORT=8000

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=kosanhub
DB_USERNAME=kosanhub
DB_PASSWORD=ganti-password-database
# Password root MySQL (hanya dipakai container db)
DB_ROOT_PASSWORD=ganti-password-root

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Antrean job tagihan memakai tabel "jobs" di database
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@kosanhub.test"
MAIL_FROM_NAME="${APP_NAME}"
